NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=sb_secret_your-server-secret-key
# Legacy projects may use a JWT service role key instead:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Local demos only. Omit or set mercadopago for real checkouts (default is mercadopago).
PAYMENT_MODE=simulation
CRAFTPANEL_ADMIN_EMAILS=you@example.com
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-production-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-signing-secret
# Mercado Pago requires a public HTTPS URL for back_urls and the webhook.
NEXT_PUBLIC_APP_URL=https://your-public-domain.example
